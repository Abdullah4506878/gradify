// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  SUPERVISOR
  STUDENT
}

enum Semester {
  FALL
  SPRING
  SUMMER
}

enum Phase {
  FYP_1
  FYP_2
}

enum GroupStatus {
  FORMING
  ACTIVE
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  PASSED
  FAILED
  REPEATING
}

enum MOMStatus {
  DRAFT
  SUBMITTED
}

enum TaskType {
  DOCUMENTATION
  DEVELOPMENT_WEB
  DEVELOPMENT_MOBILE
}

enum TaskStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  ACCEPTED_MINOR_ISSUES
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  name                  String?
  password              String
  role                  Role                   @default(STUDENT)
  refreshToken          String?
  universityId          Int?
  university            University?            @relation(fields: [universityId], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  ledGroups             Group[]                @relation("GroupLeader")
  enrollments           Enrollment[]
  supervisorPreferences SupervisorPreference[] @relation("SupervisorPreference")
  supervisedMOMs        MeetingMinutes[]       @relation("SupervisorMOM")
  assignedTasks         Task[]                 @relation("TaskAssignee")
  supervisedTasks       Task[]                 @relation("TaskSupervisor")
  taskReviews           TaskReview[]           @relation("TaskReviewer")
}

model University {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  users       User[]
}

model Department {
  id           Int        @id @default(autoincrement())
  name         String
  code         String
  universityId Int
  university   University @relation(fields: [universityId], references: [id])
  programs     Program[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([code, universityId])
}

model Program {
  id           Int               @id @default(autoincrement())
  name         String
  code         String
  departmentId Int
  department   Department        @relation(fields: [departmentId], references: [id])
  sessions     AcademicSession[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([code, departmentId])
}

model AcademicSession {
  id        Int        @id @default(autoincrement())
  name      String
  semester  Semester
  year      Int
  programId Int
  program   Program    @relation(fields: [programId], references: [id])
  phases    FYPPhase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([semester, year, programId])
}

model FYPPhase {
  id        Int             @id @default(autoincrement())
  phase     Phase
  sessionId Int
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  groups    Group[]

  @@unique([phase, sessionId])
}

model Group {
  id             Int                    @id @default(autoincrement())
  fypId          String                 @unique
  universityId   Int
  phaseId        Int
  leaderId       Int
  status         GroupStatus            @default(FORMING)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  phase          FYPPhase               @relation(fields: [phaseId], references: [id])
  leader         User                   @relation("GroupLeader", fields: [leaderId], references: [id])
  members        Enrollment[]
  preferences    SupervisorPreference[]
  meetingMinutes MeetingMinutes[]
  tasks          Task[]
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  userId    Int
  groupId   Int
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
  group     Group            @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model SupervisorPreference {
  id           Int      @id @default(autoincrement())
  groupId      Int
  supervisorId Int
  preference   Int
  createdAt    DateTime @default(now())
  group        Group    @relation(fields: [groupId], references: [id])
  supervisor   User     @relation("SupervisorPreference", fields: [supervisorId], references: [id])

  @@unique([groupId, preference])
}

model MeetingMinutes {
  id           Int       @id @default(autoincrement())
  groupId      Int
  supervisorId Int
  meetingDate  DateTime
  agenda       String
  discussion   String
  decisions    String
  nextSteps    String?
  attendees    String
  status       MOMStatus @default(DRAFT)
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  group        Group     @relation(fields: [groupId], references: [id])
  supervisor   User      @relation("SupervisorMOM", fields: [supervisorId], references: [id])
}

model Task {
  id           Int             @id @default(autoincrement())
  groupId      Int
  assignedToId Int
  supervisorId Int
  title        String
  description  String?
  type         TaskType
  deadline     DateTime
  status       TaskStatus      @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  group        Group           @relation(fields: [groupId], references: [id])
  assignedTo   User            @relation("TaskAssignee", fields: [assignedToId], references: [id])
  supervisor   User            @relation("TaskSupervisor", fields: [supervisorId], references: [id])
  submission   TaskSubmission?
  review       TaskReview?
}

model TaskSubmission {
  id          Int      @id @default(autoincrement())
  taskId      Int      @unique
  description String
  fileUrl     String?
  githubUrl   String?
  submittedAt DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id])
}

model TaskReview {
  id         Int        @id @default(autoincrement())
  taskId     Int        @unique
  reviewedBy Int
  status     TaskStatus
  reason     String
  reviewedAt DateTime   @default(now())
  task       Task       @relation(fields: [taskId], references: [id])
  reviewer   User       @relation("TaskReviewer", fields: [reviewedBy], references: [id])
}