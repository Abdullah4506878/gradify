// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  SUPERVISOR
  STUDENT
  SUPER_ADMIN
}

enum Semester {
  FALL
  SPRING
  SUMMER
}

enum Phase {
  FYP_1
  FYP_2
}

enum GroupStatus {
  FORMING
  ACTIVE
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  PASSED
  FAILED
  REPEATING
}

enum MOMStatus {
  DRAFT
  SUBMITTED
}

enum FypRole {
  DOCUMENTATION
  DEVELOPMENT
}

enum TaskStatus {
  PENDING
  SUBMITTED
  APPROVED
  MINOR_ISSUES
  REJECTED
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  name                  String?
  rollNumber            String?                @unique
  section               String?
  password              String
  isFirstLogin          Boolean                @default(true)
  role                  Role                   @default(STUDENT)
  maxGroups             Int                    @default(5)
  refreshToken          String?
  isActive              Boolean                @default(true)
  universityId          Int?
  university            University?            @relation(fields: [universityId], references: [id])
  githubUrl             String?
  linkedinUrl           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  ledGroups             Group[]                @relation("GroupLeader")
  enrollments           Enrollment[]
  supervisorPreferences SupervisorPreference[] @relation("SupervisorPreference")
  supervisedMOMs        MeetingMinutes[]       @relation("SupervisorMOM")
  supervisedTasks       Task[]                 @relation("TaskSupervisor")
  taskMemberStatuses    TaskMemberStatus[]
  taskSubmissions       TaskSubmission[]
  taskReviews           TaskReview[]           @relation("TaskReviewer")
  notifications         Notification[]
  receivedInvites       GroupInvite[]          @relation("InvitedUser")
  sentInvites           GroupInvite[]          @relation("InviterUser")
  weeklyCommits         WeeklyCommit[]
  auditLogs             AuditLog[]
  announcements         Announcement[]         @relation("AnnouncementAdmin")
}

model University {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  city        String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  users       User[]
}

model Department {
  id           Int        @id @default(autoincrement())
  name         String
  code         String
  universityId Int
  university   University @relation(fields: [universityId], references: [id])
  programs     Program[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([code, universityId])
}

model Program {
  id           Int               @id @default(autoincrement())
  name         String
  code         String
  departmentId Int
  department   Department        @relation(fields: [departmentId], references: [id])
  sessions     AcademicSession[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([code, departmentId])
}

model AcademicSession {
  id        Int        @id @default(autoincrement())
  name      String
  semester  Semester
  year      Int
  isActive  Boolean    @default(true)
  programId Int
  program   Program    @relation(fields: [programId], references: [id])
  phases    FYPPhase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([semester, year, programId])
}

model FYPPhase {
  id        Int             @id @default(autoincrement())
  phase     Phase
  sessionId Int
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  groups    Group[]

  @@unique([phase, sessionId])
}

model Group {
  id                 Int                    @id @default(autoincrement())
  fypId              String?                @unique
  universityId       Int
  phaseId            Int
  leaderId           Int
  status             GroupStatus            @default(FORMING)
  supervisorAssigned Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  phase          FYPPhase               @relation(fields: [phaseId], references: [id])
  leader         User                   @relation("GroupLeader", fields: [leaderId], references: [id])
  members        Enrollment[]
  preferences    SupervisorPreference[]
  meetingMinutes MeetingMinutes[]
  tasks          Task[]
  proposal       Proposal?
  invites        GroupInvite[]
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  userId    Int
  groupId   Int
  status    EnrollmentStatus @default(ACTIVE)
  fypRole   FypRole?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
  group     Group            @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model SupervisorPreference {
  id           Int      @id @default(autoincrement())
  groupId      Int
  supervisorId Int
  preference   Int
  createdAt    DateTime @default(now())
  group        Group    @relation(fields: [groupId], references: [id])
  supervisor   User     @relation("SupervisorPreference", fields: [supervisorId], references: [id])

  @@unique([groupId, preference])
}

model MeetingMinutes {
  id           Int       @id @default(autoincrement())
  groupId      Int
  supervisorId Int
  meetingDate  DateTime
  agenda       String
  discussion   String
  decisions    String
  nextSteps        String?
  attendees        String
  actionItems      String?
  nextMeetingDate  String?
  nextMeetingTime  String?
  nextMeetingVenue String?
  participants     String?
  status           MOMStatus @default(DRAFT)
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  group        Group     @relation(fields: [groupId], references: [id])
  supervisor   User      @relation("SupervisorMOM", fields: [supervisorId], references: [id])
}

model Task {
  id             Int                @id @default(autoincrement())
  groupId        Int
  supervisorId   Int
  title          String
  description    String?
  deadline       DateTime
  status         TaskStatus         @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  group          Group              @relation(fields: [groupId], references: [id])
  supervisor     User               @relation("TaskSupervisor", fields: [supervisorId], references: [id])
  memberStatuses TaskMemberStatus[]
  submissions    TaskSubmission[]
  reviews        TaskReview[]
}

model TaskMemberStatus {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

model TaskSubmission {
  id          Int      @id @default(autoincrement())
  taskId      Int
  userId      Int
  description String?
  fileUrl     String?
  githubLink  String?
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model TaskReview {
  id         Int        @id @default(autoincrement())
  taskId     Int
  reviewerId Int
  status     TaskStatus
  reason     String
  createdAt  DateTime   @default(now())
  task       Task       @relation(fields: [taskId], references: [id])
  reviewer   User       @relation("TaskReviewer", fields: [reviewerId], references: [id])
}

model Proposal {
  id                 Int            @id @default(autoincrement())
  groupId            Int            @unique
  projectTitle       String
  problemStatement   String
  proposedSolution   String
  supervisorComments String?
  managerComments    String?
  status             ProposalStatus @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  group              Group          @relation(fields: [groupId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model GroupInvite {
  id        Int          @id @default(autoincrement())
  groupId   Int
  invitedId Int
  invitedBy Int
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  group     Group        @relation(fields: [groupId], references: [id])
  invited   User         @relation("InvitedUser", fields: [invitedId], references: [id])
  inviter   User         @relation("InviterUser", fields: [invitedBy], references: [id])
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  entityName String?
  createdAt  DateTime @default(now())
}

model WeeklyCommit {
  id          Int      @id @default(autoincrement())
  userId      Int
  weekStart   DateTime
  commitCount Int      @default(0)
  lastCommit  DateTime?
  repos       String?
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, weekStart])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userEmail String?
  role      String?
  action    String
  entity    String
  entityId  Int?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  isActive  Boolean  @default(true)
  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     User     @relation("AnnouncementAdmin", fields: [createdBy], references: [id])
}